# Copy to .env / .dev.vars for local dev. Never commit secrets.
SITE_URL=http://localhost:5173
TRUSTED_GAME_HOSTS=game-host.example.com,trusted-games.example.com,azgames.io,github.io
ADS_ENABLED=false
ANALYTICS_ENABLED=false
ENVIRONMENT=development
# Local-only fake admin principal. Never enable in production.
LOCAL_DEV_AUTH=true
# Supabase Auth (replaces Cloudflare Access). SUPABASE_URL is the project origin.
# For the Worker locally, put these in .dev.vars (never commit real secrets):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=<Settings -> API -> JWT Settings -> JWT Secret>
# SUPABASE_ANON_KEY=<Settings -> API -> Project API keys -> anon public>
# SUPABASE_SERVICE_ROLE_KEY=<optional; enables the profiles.role lookup>
# SUPABASE_ADMIN_EMAILS=you@example.com   # optional bootstrap allowlist
# For the browser build, put the two public values in .env / .env.production:
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>
# Production secrets (wrangler secret put):
# CSRF_SECRET=      # 32+ random chars, used to sign admin CSRF tokens
# AI_KEYS_SECRET=   # dedicated 32+ char secret used only to encrypt the Gemini keyring at rest (AES-GCM). Changing it requires re-entering keys.
# TURNSTILE_SECRET_KEY=
# GEMINI_API_KEY=   # optional; free-tier Google Gemini key for the AI Writer (format: AIza… or AQ.…). If unset, add/rotate keys in the /admin/ai dashboard (stored AES-GCM encrypted). Restrict the key to the Generative Language API.
VITE_SITE_URL=https://slopecurve.com
VITE_ADS_ENABLED=false
VITE_ANALYTICS_ENABLED=false
