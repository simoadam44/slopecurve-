# Public build-time values for production builds (committed on purpose: no secrets).
# Vite loads this file automatically for `vite build` (mode=production).
#
# VITE_SITE_URL MUST equal the Worker's SITE_URL var in wrangler.jsonc, otherwise the
# server-rendered and client-side canonical tags disagree.
#
# Current host: workers.dev. When slopecurve.com is attached to the Worker, change this
# line AND `vars.SITE_URL` in wrangler.jsonc to https://slopecurve.com, then rebuild.
VITE_SITE_URL=https://slopecurve.hamdi708090.workers.dev

# Keep in sync with `vars.TRUSTED_GAME_HOSTS` in wrangler.jsonc.
VITE_TRUSTED_GAME_HOSTS=game-host.example.com,trusted-games.example.com,azgames.io,github.io
