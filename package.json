{
  "name": "slopecurve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node -e \"const fs=require('fs');for(const p of ['dist/slopecurve/.dev.vars','dist/.dev.vars'])try{fs.rmSync(p)}catch{}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:apply": "wrangler d1 migrations apply slopecurve-db",
    "db:apply:remote": "wrangler d1 migrations apply slopecurve-db --remote"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "jose": "^6.2.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.4",
    "xss": "^1.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.2",
    "vite": "^6.4.5",
    "vitest": "^2.1.9",
    "wrangler": "4.151.0"
  }
}
