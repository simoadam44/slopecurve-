{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slopecurve",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",

  // Publish to https://slopecurve.<account>.workers.dev on every deploy.
  // Attach slopecurve.com as a custom domain in the dashboard (or via `routes` below).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/**", "!/@vite/**", "!/@react-refresh", "!/@fs/**", "!/src/**", "!/node_modules/**", "!/__/**"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slopecurve-db",
      // Created 2026-10-26 (`npx wrangler d1 create slopecurve-db`, region WEUR).
      "database_id": "3aa5cb41-323e-4399-bb02-cad56f322964"
    }
  ],

  // Optional: serve the Worker on your own domain instead of adding it in the dashboard.
  // Requires the zone's DNS to be on Cloudflare.
  // "routes": [{ "pattern": "slopecurve.com", "custom_domain": true }],

  // Admin authentication uses Supabase Auth. Set these with `wrangler secret put`:
  //   SUPABASE_URL                https://<project-ref>.supabase.co
  //   SUPABASE_JWT_SECRET         Settings -> API -> JWT Settings -> JWT Secret
  //   SUPABASE_ANON_KEY           optional; lets the Worker verify tokens remotely
  //   SUPABASE_SERVICE_ROLE_KEY   optional; enables the profiles.role admin lookup
  //   SUPABASE_ADMIN_EMAILS       optional bootstrap allowlist (comma separated)
  //   SUPABASE_TRUST_USER_METADATA  leave unset; "true" also accepts user_metadata.role
  "vars": {
    // Must match .env.production -> VITE_SITE_URL; both are the public origin used
    // for canonicals/OG/sitemap. Switch both to https://slopecurve.com once the
    // domain's nameservers point at Cloudflare.
    "SITE_URL": "https://slopecurve.hamdi708090.workers.dev",
    "TRUSTED_GAME_HOSTS": "game-host.example.com,trusted-games.example.com,azgames.io,github.io",
    "ADS_ENABLED": "false",
    "ANALYTICS_ENABLED": "false",
    "ENVIRONMENT": "production",
    "LOCAL_DEV_AUTH": "false"
  }
}
